#!/bin/sh
# Builds a release binary and wraps it in an ad-hoc signed Reasonal.app.
set -eu

cd "$(dirname "$0")/.."
echo "Building release binary"
swift build -c release

app=build/Reasonal.app
echo "Assembling $app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$(swift build -c release --show-bin-path)/Reasonal" "$app/Contents/MacOS/Reasonal"
cp Resources/Info.plist "$app/Contents/Info.plist"
codesign --force --sign - "$app"

echo "$app"
